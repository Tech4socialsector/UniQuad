{
 "doctype": "DocType",
 "name": "Applicant Document",
 "module": "Admission",
 "is_submittable": 1,
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "applicant",
   "fieldtype": "Link",
   "label": "Applicant",
   "options": "Applicant",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "document_type",
   "fieldtype": "Select",
   "label": "Document Type",
   "options": "\n10th Certificate\n12th Certificate\nDegree Certificate\nCLAT Scorecard\nNLSAT Scorecard\nCategory Certificate\nPwD Certificate\nResearch Proposal\nID Proof\nPhoto\nCV\nOther",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "file",
   "fieldtype": "Attach",
   "label": "File",
   "reqd": 1
  },
  {
   "fieldname": "checksum",
   "fieldtype": "Data",
   "label": "SHA-256 Checksum",
   "read_only": 1
  },
  {
   "fieldname": "is_verified",
   "fieldtype": "Check",
   "label": "Is Verified",
   "in_list_view": 1
  },
  {
   "fieldname": "verified_by",
   "fieldtype": "Link",
   "label": "Verified By",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "verified_on",
   "fieldtype": "Datetime",
   "label": "Verified On",
   "read_only": 1
  },
  {
   "fieldname": "is_locked",
   "fieldtype": "Check",
   "label": "Is Locked",
   "read_only": 1
  },
  {
   "fieldname": "rejection_reason",
   "fieldtype": "Text",
   "label": "Rejection Reason",
   "depends_on": "eval:doc.is_verified==0 && doc.docstatus==1"
  },
  {
   "fieldname": "campus",
   "fieldtype": "Link",
   "label": "Campus",
   "options": "Company"
  },
  {
   "fieldname": "admission_cycle",
   "fieldtype": "Link",
   "label": "Admission Cycle",
   "options": "Admission Cycle"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1
  },
  {
   "role": "Admission Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1
  },
  {
   "role": "Admission Officer",
   "read": 1,
   "write": 1,
   "submit": 1
  },
  {
   "role": "Evaluator",
   "read": 1
  },
  {
   "role": "Applicant",
   "read": 1,
   "create": 1
  }
 ]
}