{% set _pc = portal_config %}
{% set _primary   = (_pc.primary_color   if _pc else None) or primary_color   or "#CB2929" %}
{% set _secondary = (_pc.secondary_color if _pc else None) or secondary_color or "#8B1A1A" %}
{% set _name      = (_pc.portal_title    if _pc else None) or institution_name or "SLCM" %}
{% set _logo      = portal_logo or (_pc.logo if _pc else None) or "" %}
{% set _tagline   = (_pc.portal_tagline  if _pc else None) or portal_tagline   or "Shaping Tomorrow's Legal Minds" %}
{% set _support   = (_pc.support_email   if _pc else None) or support_email    or "" %}
{% set _redir     = redirect_to or "/merit-and-scholarship/admission_dashboard?panel=profile" %}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">


  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — {{ _name }} Admission Portal</title>
  <link rel="stylesheet" href="/assets/slcm/css/applicant_portal.css">
  <style>
    :root {
      --primary:   {{ _primary }};
      --secondary: {{ _secondary }};
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; /* font-family: set via get_typography_style_block */
    background: #f1f3f5; overflow-x: hidden; }

    /* ─── NOTIFICATIONS ─── */
    .lp-notify {
      display: none; align-items: center; gap: 10px;
      padding: 10px 14px; border-radius: 8px; margin-bottom: 20px;
      font-size: 1rem; animation: fadeIn .2s ease;
    }
    .lp-notify.success { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .lp-notify.danger,
    .lp-notify.error   { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
    .lp-notify.info    { background: #dbeafe; color: #1e40af; border: 1px solid #bfdbfe; }
    .lp-notify .material-symbols-outlined { font-size: 18px; flex-shrink: 0; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(-5px); } to { opacity: 1; transform: none; } }

    /* ─── FIELD ERRORS ─── */
    .lp-field-error {
      color: #dc2626; font-size: 11px!important; font-weight: 400;
      margin-top: 5px; display: none; animation: fadeIn .2s ease;
    }

    /* ─── LAYOUT ─── */
    .lp-wrap { display: flex; min-height: 100vh; }

    /* ─── LEFT — base (desktop ≥1100px) ─── */
    .lp-left {
      width: 460px; flex: 0 0 460px;
      background: #fff; display: flex; flex-direction: column;
      justify-content: center; padding: 52px 48px;
      box-shadow: 4px 0 24px rgba(0,0,0,.07); position: relative; z-index: 2;
      overflow-y: auto;
    }

    /* brand */
    .lp-brand { display: flex; align-items: center; gap: 14px; margin-bottom: 44px; }
    .lp-brand-icon {
      width: 50px; height: 50px;
      background: var(--primary); display: flex; align-items: center;
      justify-content: center; color: #fff; flex-shrink: 0; overflow: hidden;
    }
    .lp-brand-icon img { width: 100%; height: 100%; object-fit: contain; }
    .lp-brand-icon .material-symbols-outlined { font-size: 26px; }
    .lp-brand-name { font-size: 26px; font-weight: 400; color: var(--primary); line-height: 1.2; }
    .lp-brand-sub  { font-size: 10px; font-weight: 400; letter-spacing: .12em;
                     color: #9ca3af; margin-top: 2px; }
    .lp-heading { font-size: 20px; font-weight: 400; color: #111827; margin-bottom: 6px; }
    .lp-sub     { font-size: 12.5px; color: #6b7280; margin-bottom: 30px; line-height: 1.5; }

    /* tabs */
    .lp-tabs { display: flex; border-bottom: 2px solid #e5e7eb; margin-bottom: 28px; }
    .lp-tab {
      padding: 9px 22px; font-size: 11.5px; font-weight: 400;
      background: none; border: none; cursor: pointer; color: #9ca3af;
      border-bottom: 3px solid transparent; margin-bottom: -2px;
      font-family: inherit; transition: color .2s, border-color .2s;
    }
    .lp-tab.active { color: var(--primary); border-bottom-color: var(--primary); }

    /* form fields */
    .lp-field { margin-bottom: 18px; }
    .lp-label { display: block; font-weight: 400;
                color: #374151; margin-bottom: 6px; letter-spacing: .02em; }
    .lp-label .mandatory { color: #ef4444; margin-left: 2px; }
    .lp-input {
      width: 100%; padding: 11px 14px; border: 1.5px solid #d1d5db;
      border-radius: 8px; color: #111827;
      font-family: inherit; outline: none;
      transition: border-color .2s, box-shadow .2s;
    }
    .lp-input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 12%, transparent);
    }
    .lp-input.invalid { border-color: #ef4444; }
    .lp-input::placeholder { color: #9ca3af; }
    .lp-row   { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
    .lp-forgot { font-size: 12.5px; color: var(--primary); font-weight: 400; text-decoration: none; }
    .lp-forgot:hover { text-decoration: underline; }
    .pw-wrap, .lp-input-wrap { position: relative; }
    
    .pw-btn  {
      position: absolute; right: 11px; top: 50%; transform: translateY(-50%);
      background: none; border: none; cursor: pointer; color: #9ca3af;
      display: flex; align-items: center; padding: 0;
    }
    .pw-btn .material-symbols-outlined { font-size: 18px; }
    .lp-field-hint { font-size: 11px; color: #9ca3af; margin-top: 4px; }
    
    /* Email Verification Status Indicator — Positioned Inside Input */
    #email-status {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 10px;
      font-weight: 400;
      pointer-events: none;
      z-index: 5;
      white-space: nowrap;
      transition: opacity .2s;
    }

    /* buttons */
    .lp-btn {
      width: 100%; padding: 13px; background: var(--primary); color: #fff;
      border: none; border-radius: 8px; font-size: 12px; font-weight: 400;
      cursor: pointer; font-family: inherit; letter-spacing: .03em;
      text-transform: uppercase;
      transition: opacity .2s, transform .1s;
      display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .lp-btn:hover   { opacity: .9; }
    .lp-btn:active  { transform: scale(.99); }
    .lp-btn:disabled { opacity: .65; cursor: not-allowed; }
    .lp-btn .material-symbols-outlined { font-size: 18px; }
    .lp-btn-spin {
      width: 16px; height: 16px; border: 2px solid rgba(255,255,255,.4);
      border-top-color: #fff; border-radius: 50%;
      animation: spin .6s linear infinite; display: none;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* support */
    .lp-support { margin-top: 40px; }
    .lp-support-title {
      font-size: 10px; font-weight: 400; letter-spacing: .12em;
      color: #3a3d43; margin-bottom: 14px;
    }
    .lp-support-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .lp-support-link {
      display: flex; align-items: center; gap: 7px;
      font-size: 12.5px; color: var(--primary); text-decoration: none; transition: color .2s;
    }
    .lp-support-link:hover { color: var(--primary); }
    .lp-support-link .material-symbols-outlined { font-size: 17px; }

    /* ─── RIGHT ─── */
    .lp-right {
      flex: 1; position: relative; overflow: hidden; background: #0d1b2a;
    }
    .lp-right-bg {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; opacity: .28;
    }
    .lp-right-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(140deg,
        color-mix(in srgb, var(--primary) 82%, #000) 0%, #0a1628 65%);
      opacity: .85;
    }
    .lp-right-body {
      position: relative; z-index: 2;
      display: flex; flex-direction: column;
      justify-content: center; align-items: flex-start;
      height: 100%; min-height: 100vh;
      padding: 48px 44px; color: #fff;
      overflow-y: auto;
    }
    .lp-tagline { font-size: 21px; font-weight: 400; line-height: 1.2;
                  margin-bottom: 28px; max-width: 620px; text-align: center;
                  align-self: center; margin-left: auto; margin-right: auto; }

    /* glass card */
    .glass {
      background: rgba(255,255,255,.08); backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px); border: 1px solid rgba(255,255,255,.15);
      border-radius: 14px; padding: 20px 22px; margin-bottom: 14px; width: 100%;
    }
    .glass-head  { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
    .glass-title { display: flex; align-items: center; gap: 9px; }
    .glass-icon  {
      width: 26px; height: 26px; border-radius: 50%; background: #fff;
      display: flex; align-items: center; justify-content: center;
      color: var(--primary); flex-shrink: 0;
    }
    .glass-icon .material-symbols-outlined { font-size: 14px; }
    .glass-badge { font-size: 9px; font-weight: 400; letter-spacing: .1em;
                   opacity: .65; }

    /* announcement rows */
    .ann-row {
      display: flex; align-items: flex-start; gap: 10px;
      padding: 8px 6px; border-radius: 8px; cursor: pointer;
      border-bottom: 1px solid rgba(255,255,255,.07);
      transition: background .15s;
    }
    .ann-row:last-child { border-bottom: none; }
    .ann-row:hover { background: rgba(255,255,255,.07); }
    .ann-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; margin-top: 5px; }
    .ann-text { flex: 1; min-width: 0; }
    .ann-title { line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ann-summary {opacity: .6; margin-top: 2px;
                   white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ann-row .material-symbols-outlined { font-size: 16px; opacity: .45; margin-top: 3px; }

    .type-General   { background: #60a5fa; }
    .type-Important { background: #f87171; }
    .type-Alert     { background: #f87171; }
    .type-Event     { background: #34d399; }
    .type-Deadline  { background: #fbbf24; }
    .type-default   { background: rgba(255,255,255,.4); }

    /* date rows in Important Dates */
    .date-item {
      display: flex; align-items: center; gap: 10px;
      padding: 8px 6px; border-radius: 8px;
      border-bottom: 1px solid rgba(255,255,255,.07);
      transition: background .15s;
    }
    .date-item:last-child { border-bottom: none; }
    .date-item.clickable { cursor: pointer; }
    .date-item.clickable:hover { background: rgba(255,255,255,.07); }
    .date-item-icon {
      width: 38px; height: 38px; border-radius: 8px; flex-shrink: 0;
      background: rgba(255,255,255,.12);
      display: flex; flex-direction: column; align-items: center;
      justify-content: center; font-size: 10px; font-weight: 400;
      line-height: 1; letter-spacing: .01em;
    }
    .date-item-icon .dim { font-size: 15px; font-weight: 400; }
    .date-item-body { flex: 1; min-width: 0; }
    .date-item-label { line-height: 1.4;
                       white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .date-item-sub { font-size: 10px; opacity: .55; margin-top: 1px; }
    .date-badge {
      font-size: 8px; font-weight: 400; letter-spacing: .08em;
      padding: 2px 6px; border-radius: 99px; flex-shrink: 0;
      text-transform: uppercase;
    }
    .badge-today    { background: #fbbf24; color: #78350f; }
    .badge-tomorrow { background: #60a5fa; color: #1e3a8a; }
    .badge-event    { background: #34d399; color: #064e3b; }
    .badge-deadline { background: #f87171; color: #7f1d1d; }
    .badge-cycle    { background: rgba(255,255,255,.2); color: #fff; }
    .badge-apps     { background: rgba(255,255,255,.12); color: rgba(255,255,255,.8); }

    /* event modal */
    .ev-modal-bg {
      display: none; position: fixed; inset: 0; z-index: 9000;
      background: rgba(0,0,0,.6); backdrop-filter: blur(4px);
      align-items: center; justify-content: center; padding: 20px;
    }
    .ev-modal-bg.open { display: flex; }
    .ev-modal {
      background: #fff; border-radius: 18px; width: 100%; max-width: 500px;
      max-height: 88vh; overflow-y: auto;
      box-shadow: 0 28px 72px rgba(0,0,0,.28);
      animation: modalIn .22s ease;
    }
    .ev-mhead {
      padding: 22px 24px 16px; border-bottom: 1px solid #e5e7eb;
      display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;
    }
    .ev-mtitle { font-size: 18px; font-weight: 400; color: #111827; line-height: 1.3; }
    .ev-mclose {
      background: #f3f4f6; border: none; border-radius: 50%;
      width: 32px; height: 32px; cursor: pointer; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center; color: #6b7280;
    }
    .ev-mclose:hover { background: #e5e7eb; }
    .ev-mclose .material-symbols-outlined { font-size: 17px; }
    .ev-mmeta {
      padding: 10px 24px; background: #f9fafb;
      display: flex; flex-wrap: wrap; gap: 14px; border-bottom: 1px solid #e5e7eb;
    }
    .ev-mmeta-item { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #6b7280; }
    .ev-mmeta-item .material-symbols-outlined { font-size: 15px; color: var(--primary); }
    .ev-mimg { width: 100%; max-height: 180px; object-fit: cover; display: none; }
    .ev-mbody { padding: 18px 24px; }
    .ev-msummary { font-size: 14px; color: #374151; font-weight: 400;
                   margin-bottom: 12px; line-height: 1.6; }
    .ev-mcontent { font-size: 13px; color: #4b5563; line-height: 1.75; }
    .ev-mfooter { padding: 14px 24px; border-top: 1px solid #e5e7eb; }
    .ev-reg-btn {
      display: block; width: 100%; padding: 12px; text-align: center;
      background: var(--primary); color: #fff; border: none; border-radius: 10px;
      font-size: 13px; font-weight: 400; cursor: pointer; text-decoration: none;
      font-family: inherit; transition: opacity .2s;
    }
    .ev-reg-btn:hover { opacity: .88; }

    /* pagination controls inside glass cards */
    .card-pager {
      display: flex; align-items: center; justify-content: space-between;
      padding: 8px 2px 2px; margin-top: 6px;
      border-top: 1px solid rgba(255,255,255,.08);
    }
    .card-pager-info { font-size: 10px; opacity: .55; font-weight: 400; }
    .card-pager-btns { display: flex; gap: 4px; }
    .card-pager-btn {
      background: rgba(255,255,255,.12); border: none; color: #fff;
      width: 24px; height: 24px; border-radius: 6px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      font-size: 14px; transition: background .15s; font-family: inherit;
    }
    .card-pager-btn:hover:not(:disabled) { background: rgba(255,255,255,.22); }
    .card-pager-btn:disabled { opacity: .3; cursor: not-allowed; }
    .lp-social { display: flex; align-items: center; gap: 12px; margin-top: 18px; }
    .lp-social-icon {
      width: 36px; height: 36px; border-radius: 50%;
      background: var(--primary); border: 2px solid #fff;
      display: flex; align-items: center; justify-content: center; color: #fff;
    }
    .lp-social-icon .material-symbols-outlined { font-size: 18px; }
    .lp-social-text { opacity: .8; }

    /* ─── ANNOUNCEMENT MODAL ─── */
    .ann-modal-bg {
      display: none; position: fixed; inset: 0; z-index: 8000;
      background: rgba(0,0,0,.55); backdrop-filter: blur(4px);
      align-items: center; justify-content: center; padding: 20px;
    }
    .ann-modal-bg.open { display: flex; }
    .ann-modal {
      background: #fff; border-radius: 16px; width: 100%; max-width: 520px;
      max-height: 85vh; overflow-y: auto;
      box-shadow: 0 24px 64px rgba(0,0,0,.25);
      animation: modalIn .2s ease;
    }
    @keyframes modalIn {
      from { opacity: 0; transform: translateY(14px) scale(.97); }
      to   { opacity: 1; transform: none; }
    }
    .ann-mhead {
      padding: 20px 22px 16px; border-bottom: 1px solid #e5e7eb;
      display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;
    }
    .ann-mtitle { font-size: 17px; font-weight: 400; color: #111827; line-height: 1.3; }
    .ann-mclose {
      background: #f3f4f6; border: none; border-radius: 50%;
      width: 30px; height: 30px; cursor: pointer; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center; color: #6b7280;
    }
    .ann-mclose:hover { background: #e5e7eb; }
    .ann-mclose .material-symbols-outlined { font-size: 17px; }
    .ann-mmeta {
      padding: 10px 22px; background: #f9fafb;
      display: flex; flex-wrap: wrap; gap: 14px; border-bottom: 1px solid #e5e7eb;
    }
    .ann-mmeta-item { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #6b7280; }
    .ann-mmeta-item .material-symbols-outlined { font-size: 15px; color: var(--primary); }
    .ann-mimg  { width: 100%; max-height: 200px; object-fit: cover; display: none; }
    .ann-mbody { padding: 18px 22px; }
    .ann-msummary { font-size: 14px; color: #374151; font-weight: 400;
                    margin-bottom: 12px; line-height: 1.6; display: none; }
    .ann-mcontent { font-size: 13px; color: #4b5563; line-height: 1.7; }
    .ann-mcontent p  { margin-bottom: 10px; }
    .ann-mcontent ul { padding-left: 18px; margin-bottom: 10px; }

    /* ══════════════════════════════════════════════════
       RESPONSIVE — left panel GROWS as screen shrinks,
       right panel shrinks (flex:1 handles it automatically)
    ══════════════════════════════════════════════════ */

    /* 4K / 2K (≥2000px): left = 1/3 of screen */
    @media (min-width: 2000px) {
      .lp-left { width: 33.333vw; flex: 0 0 33.333vw; padding: 72px 80px; }
      .lp-heading { font-size: 20px; }
      .lp-sub { font-size: 12.5px; }
      .lp-input { font-size: 13.5px; padding: 14px 16px; }
      .lp-btn { font-size: 12px; padding: 16px; }
      .lp-brand-name { font-size: 26px; }
      .lp-right-body { padding: 80px 72px; }
      .lp-tagline { font-size: 21px; max-width: 560px; }
    }

    /* Large desktop (1400px–1999px) */
    @media (min-width: 1400px) and (max-width: 1999px) {
      .lp-left { width: 520px; flex: 0 0 520px; padding: 60px 56px; }
      .lp-right-body { padding: 64px 60px; }
      .lp-tagline { font-size: 21px; max-width: 500px; }
    }

    /* Medium desktop (1100px–1399px) — default styles apply */

    /* Small desktop (861px–1099px): left grows to take more space */
    @media (min-width: 861px) and (max-width: 1099px) {
      .lp-left { width: 440px; flex: 0 0 440px; padding: 44px 36px; }
      .lp-right-body { padding: 36px 28px; }
      .lp-tagline { font-size: 21px; max-width: 340px; }
      .glass { padding: 16px 18px; }
      .glass-title { font-size: 13px; }
      .date-val { font-size: 17px; }
    }

    /* Tablet (≤860px): right hidden, left fills full screen */
    @media (max-width: 860px) {
      .lp-wrap { justify-content: center; background: #fff; }
      .lp-left {
        width: 100%; flex: 1; max-width: 540px;
        margin: 0 auto; padding: 48px 36px;
        justify-content: flex-start;
        box-shadow: none; min-height: 100vh;
      }
      .lp-right { display: none; }
    }

    /* Mobile (≤600px) */
    @media (max-width: 600px) {
      .lp-left { padding: 36px 24px; max-width: 100%; }
      .lp-heading { font-size: 20px; }
      .lp-sub { font-size: 12.5px; margin-bottom: 24px; }
      .lp-brand { margin-bottom: 32px; }
      .lp-brand-name { font-size: 13px; }
      .lp-tagline { font-size: 15px; }
    }

    /* Small mobile (≤480px) */
    @media (max-width: 480px) {
      .lp-left { padding: 28px 16px; }
      .lp-heading { font-size: 20px; }
      .lp-tabs { margin-bottom: 20px; }
      .lp-tab { padding: 8px 16px; font-size: 9.5px; }
      .lp-support-grid { grid-template-columns: 1fr; }
      .lp-btn { font-size: 12px; padding: 11px; }
      .lp-support { margin-top: 30px; }
    }
  </style>

{{ get_typography_style_block(
    portal_config.font_family,
    font_size_heading=portal_config.font_size_heading,
    font_size_subheading=portal_config.font_size_subheading,
    font_size_body=portal_config.font_size_body,
    font_size_form_title=portal_config.font_size_form_title,
    font_size_toast=portal_config.font_size_toast,
    primary_color=portal_config.primary_color,
    secondary_color=portal_config.secondary_color,
    navbar_color=portal_config.navbar_color,
    footer_color=portal_config.footer_color,
    button_border_radius=portal_config.button_border_radius
) }}

<!-- Meta Pixel Code -->
<script>
!function(f,b,e,v,n,t,s)
{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};
if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];
s.parentNode.insertBefore(t,s)}(window, document,'script',
'https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '1279045953496223');
fbq('track', 'PageView');
</script>
<noscript><img height="1" width="1" style="display:none"
src="https://www.facebook.com/tr?id=1279045953496223&ev=PageView&noscript=1"
/></noscript>

<!-- End Meta Pixel Code -->

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=AW-11282568347"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'AW-11282568347');
