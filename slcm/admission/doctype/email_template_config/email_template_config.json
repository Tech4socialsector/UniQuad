{
  "doctype": "DocType",
  "name": "Email Template Config",
  "module": "Admission",
  "track_changes": 1,
  "autoname": "field:template_name",
  "title_field": "template_name",
  "fields": [
    {"fieldname": "template_name", "fieldtype": "Data", "label": "Template Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "trigger_event", "fieldtype": "Select", "label": "Trigger Event", "options": "\nApplication Submitted\nStatus Changed\nOffer Sent\nDocument Rejected\nDeadline Reminder\nInterview Scheduled\nPayment Confirmed", "reqd": 1, "in_list_view": 1},
    {"fieldname": "col_break_1", "fieldtype": "Column Break"},
    {"fieldname": "is_active", "fieldtype": "Check", "label": "Active", "default": "1", "in_list_view": 1},
    {"fieldname": "email_account", "fieldtype": "Link", "label": "Email Account", "options": "Email Account"},
    {"fieldname": "section_break_content", "fieldtype": "Section Break", "label": "Email Content"},
    {"fieldname": "subject", "fieldtype": "Data", "label": "Subject", "reqd": 1, "description": "Use placeholders e.g. {{candidate_name}}, {{program}}"},
    {"fieldname": "body", "fieldtype": "Text Editor", "label": "Body", "reqd": 1, "description": "Use placeholders: {{candidate_name}}, {{program}}, {{campus}}, {{applicant_id}}, {{status}}, {{deadline}}, {{offer_amount}}"},
    {"fieldname": "section_break_placeholders", "fieldtype": "Section Break", "label": "Available Placeholders"},
    {"fieldname": "available_placeholders", "fieldtype": "Small Text", "label": "Available Placeholders", "read_only": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Admission Admin", "read": 1, "write": 1, "create": 1}
  ]
}